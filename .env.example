# Example environment for the local flow tester. Copy to .env and fill in.
# .env is gitignored — never commit real values here.

# Required. OpenRouter API key used for chat completions. Leave blank in this file.
OPENROUTER_API_KEY=

# Optional. Default OpenRouter model id used when a session does not pick one.
# Falls back to inclusionai/ling-3.0-flash when unset.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash

# Optional. Port for the local server; defaults to 3100.
PORT=3100
